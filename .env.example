MAKE_WEBHOOK=https://hook.us2.make.com/SEU_WEBHOOK_AQUI
MAKE_WEBHOOK_VENDIDO=https://hook.us2.make.com/SEU_WEBHOOK_VENDIDO_AQUI

# Numero do WhatsApp (so digitos, com DDI) que recebe alertas quando o Instagram
# nao confirma uma publicacao. Ex: 5531999999999
# Se deixar vazio, o alerta vai pro proprio numero do bot (mensagem para voce mesmo).
WHATSAPP_ALERTA=

# Configuracao de grupos e regras (opcional — se vazio, usa o padrao atual do codigo).
# Trocar de grupo/valor/horario sem mexer no codigo.
GRUPO_ORIGEM_NOME=Ronei repasse
GRUPO_DESTINO_NOME=MINAS BRASIL REPASSE GRUPO 8
GRUPO_AVISO_NOME=MINAS BRASIL REPASSE GRUPO 8
ACRESCIMO=1000
HORA_AVISO=9
MINUTO_AVISO=30
